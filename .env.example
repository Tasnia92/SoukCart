# Server - copy to app/server/.env (never commit real secrets)
PORT=5000
NODE_ENV=development

# MongoDB - local Docker (default Ground Up):
#MONGODB_URI=mongodb://127.0.0.1:27017/nekcart
# Or MongoDB Atlas (cloud):
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nekcart?retryWrites=true&w=majority

JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://127.0.0.1:5173
SERVER_URL=http://127.0.0.1:5000

# Get these from https://console.cloudinary.com → Dashboard
 CLOUDINARY_CLOUD_NAME=
 CLOUDINARY_API_KEY=
 CLOUDINARY_API_SECRET=

# SSLCommerz sandbox (leave blank for COD-only local testing)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=http://127.0.0.1:5000/api/payments/ssl/success
SSLCOMMERZ_FAIL_URL=http://127.0.0.1:5000/api/payments/ssl/fail
SSLCOMMERZ_CANCEL_URL=http://127.0.0.1:5000/api/payments/ssl/cancel
SSLCOMMERZ_IPN_URL=http://127.0.0.1:5000/api/payments/ssl/ipn
