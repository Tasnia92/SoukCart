# Server - copy to app/server/.env (never commit real secrets)
PORT=5000
NODE_ENV=development

# MongoDB - local Docker (default Ground Up):
MONGODB_URI=mongodb://127.0.0.1:27017/nekcart
# Or MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nekcart?retryWrites=true&w=majority

JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Cloudinary (optional — only if you switch image uploads to Cloudinary
# instead of the default local disk storage in app/server/uploads).
# Get these from https://console.cloudinary.com → Dashboard
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# SSLCommerz — this project ALWAYS uses the sandbox environment (never live).
# Only the store credentials are required; base URLs are hardcoded to sandbox.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=